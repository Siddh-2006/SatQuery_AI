# Copy this file to `.env` (same folder, repo root, wherever your
# docker-compose.yml / shell reads it from) and fill in what you need.
# Every variable here is read exactly once, in orchestrator/app/config.py --
# see orchestrator/DESIGN.md §11 for what each one means.

# --- Port map (every service, one place) -------------------------------
# Three independent processes (orchestrator, litert_server, eocaptioner)
# each listen on their OWN port, controlled by their OWN env var -- and the
# orchestrator separately needs a full URL for each so it can reach them
# (the host differs between local dev ("localhost") and Docker Compose (a
# service name), which a bare port number can't express). If you change a
# service's port, you must update BOTH lines for it below, or the
# orchestrator will fail to connect (a `LiteRTServerUnavailable` /
# `model_error` for litert, a `segmentation_failed`-style tool error for
# eocaptioner) even though that service is running fine on its new port.
#
#   service        its own port env var    orchestrator's URL to reach it
#   -------------  -----------------------  ------------------------------
#   orchestrator   ORCHESTRATOR_PORT=8080   (n/a -- this IS the orchestrator)
#   litert_server  LITERT_SERVER_PORT=9001  LITERT_SERVER_URL (below)
#   eocaptioner    EOCAPTIONER_PORT=8000    EOCAPTIONER_URL (below)
#
# Running litert_server or eocaptioner locally on a different port? Set
# their own *_PORT env var when you launch them, and update the matching
# line below to the SAME port number before starting the orchestrator.
ORCHESTRATOR_PORT=8080
LITERT_SERVER_PORT=9001
EOCAPTIONER_PORT=8000

# --- LLM backend switch (the one thing this whole design revolves around) ---
# "litert" = local Gemma model via LiteRT-LM (default, offline, free).
# "gemini" = Google's Gemini API (needs GEMINI_API_KEY below).
LLM_BACKEND=litert

# Only read when LLM_BACKEND=litert. Where the litert_server microservice
# listens -- must match LITERT_SERVER_PORT above. This docker-compose
# default (service name "llm-litert") only works inside docker-compose;
# for local (non-Docker) dev use http://localhost:9001 instead.
LITERT_SERVER_URL=http://llm-litert:9001

# Only read when LLM_BACKEND=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Where the EOCaptioner model server (server/serve.py) listens -- must
# match EOCAPTIONER_PORT above. Same local-vs-Docker host note as
# LITERT_SERVER_URL: use http://localhost:8000 for local dev.
EOCAPTIONER_URL=http://eocaptioner:8000

# Folder holding the four BigEarthNet-*.zip archives (same ones server/
# serve.py and ui/scripts/extract_patches.py already use).
BIGEARTHNET_DATA_ROOT=/data/bigearthnet

# Where extracted per-patch band GeoTIFFs get cached. Must be the SAME
# path inside both the orchestrator and eocaptioner containers (a shared
# Docker volume) -- see docker-compose.yml and DESIGN.md §6.
ORCHESTRATOR_CACHE_DIR=/data/patch_cache

# Local persistence (DESIGN.md §10).
ORCHESTRATOR_DB_PATH=/data/orchestrator.db
UPLOAD_STORE_DIR=/data/uploads
REPORT_STORE_DIR=/data/reports

# Comma-separated list of origins allowed to call this API -- the Vite
# dev server's default port by default.
CORS_ALLOW_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# --- Demo mode (demo branch) -------------------------------------------
# true  = a request needing a not-yet-integrated specialist model (change
#         detection, optical+SAR fusion, segmentation, uploaded images,
#         SAR-only) gets a fixed stand-in answer from
#         app/demo_placeholders.py instead of a 422, so every path through
#         the UI can be walked end-to-end. Every such answer opens with
#         "[Demo placeholder - model not yet integrated]", reports
#         confidence 0.0, and sets executionTrace.parameters.placeholder.
# false = production behaviour: those requests are rejected honestly.
#         This is what `main` should run with.
# Defaults to TRUE on this branch so a demo needs no env setup at all.
DEMO_PLACEHOLDERS=true
